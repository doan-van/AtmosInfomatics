import pandas as pd

# Load data
file = 'combine_selected/47401.csv'
data = pd.read_csv(file, index_col=0, parse_dates=True)

# Ensure index is in datetime format
if not isinstance(data.index, pd.DatetimeIndex):
    data.index = pd.to_datetime(data.index)

# Define thresholds for wet and dry spells
wet_threshold = 1.0  # Precipitation > 1 mm/day defines a wet day
dry_threshold = 0  # Precipitation ≤ 1 mm/day defines a dry day

# Identify wet and dry days
data['is_wet_day'] = data['precip-accum_mm'] > wet_threshold
data['is_dry_day'] = data['precip-accum_mm'] <= dry_threshold

# Group consecutive wet and dry days
data['wet_group'] = (data['is_wet_day'] != data['is_wet_day'].shift()).cumsum()
data['dry_group'] = (data['is_dry_day'] != data['is_dry_day'].shift()).cumsum()

# Extract wet spells
wet_spells = []
for group, group_data in data[data['is_wet_day']].groupby('wet_group'):
    start_date = group_data.index.min()
    end_date = group_data.index.max()
    duration = len(group_data)
    total_precip = group_data['precip-accum_mm'].sum()
    wet_spells.append({
        'start_date': start_date,
        'end_date': end_date,
        'duration': duration,
        'total_precipitation': total_precip
    })

wet_spells = pd.DataFrame(wet_spells)

# Extract dry spells
dry_spells = []
for group, group_data in data[data['is_dry_day']].groupby('dry_group'):
    start_date = group_data.index.min()
    end_date = group_data.index.max()
    duration = len(group_data)
    dry_spells.append({
        'start_date': start_date,
