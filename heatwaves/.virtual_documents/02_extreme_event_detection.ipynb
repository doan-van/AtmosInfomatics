import os
import pandas as pd

# Define input parameters
input_directory = 'combine_selected'
output_directory = 'detected_heatwaves'
variable_name = 'temp-max_C'
quantile = 0.9
min_duration = 3
float_precision = "%.2f"  # Specify the precision for float values

# Create the output directory with descriptive name
os.makedirs(output_directory, exist_ok=True)

# Loop through each station file in the input directory
for file_name in os.listdir(input_directory[:10]):
    if not file_name.endswith('.csv'): continue
        
    station_number = file_name.split('.')[0]  # Extract station number from filename
    file_path = os.path.join(input_directory, file_name)

    # Load data
    data = pd.read_csv(file_path, index_col=0, parse_dates=True)
    if variable_name not in data.columns:
        print(f"Variable '{variable_name}' not found in {file_name}. Skipping.")
        continue

    # Extract the temperature series
    temp_series = data[variable_name]

    # Detect heatwaves
    heatwave_events, quantiles = detect_heatwaves(
        temp_series=temp_series,
        quantile=quantile,
        rolling_window=15,
        min_duration=min_duration
    )

    # Save the heatwave events to CSV
    
    heatwave_file_name = f"{station_number}_{variable_name}_q{quantile}_d{min_duration}_events.csv"
