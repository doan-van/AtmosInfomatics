    quantiles_file_path = os.path.join(output_directory, quantiles_file_name)
    quantiles.to_frame(name='temp_threshold').to_csv(quantiles_file_path, index_label='day_of_year', float_format=float_precision)

    print(f"Heatwave events for station {station_number} saved to {heatwave_file_path}.")
    print(f"Quantiles for station {station_number} saved to {quantiles_file_path}.")
        



import os
import pandas as pd

# Define input parameters
input_directory = 'combine_selected'
variable_name = 'temp-max_C'
quantile = 0.9
min_duration = 3
float_precision = "%.2f"  # Specify the precision for float values

# Define output file path with more detailed directory structure
output_directory = f'detected_heatwaves/{variable_name}_q{quantile}_d{min_duration}'
output_file = os.path.join(output_directory, 'combined_heatwaves.csv')
quantiles_file = os.path.join(output_directory, 'combined_quantiles.csv')

# Initialize lists to store all heatwave events and quantiles
all_heatwave_events = []
all_quantiles = []

# Loop through each station file in the input directory
for file_name in sorted(os.listdir(input_directory)):
    if not file_name.endswith('.csv'):
        continue

    station_number = file_name.split('.')[0]  # Extract station number from filename
    file_path = os.path.join(input_directory, file_name)

    # Load data
    data = pd.read_csv(file_path, index_col=0, parse_dates=True)
    if variable_name not in data.columns:
        print(f"Variable '{variable_name}' not found in {file_name}. Skipping.")
        continue

    # Extract the temperature series
    temp_series = data[variable_name]

    # Detect heatwaves
    heatwave_events, quantiles = detect_heatwaves(
        temp_series=temp_series,
        quantile=quantile,
        rolling_window=15,
        min_duration=min_duration
    )

    # Add station information to the heatwave events DataFrame
    heatwave_events['station_number'] = station_number
    all_heatwave_events.append(heatwave_events)

    # Add station information to the quantiles DataFrame
    quantiles_df = quantiles.to_frame(name='temp_threshold')
    quantiles_df['station_number'] = station_number
    quantiles_df.set_index('station_number', append=True, inplace=True)
    all_quantiles.append(quantiles_df)

# Combine all heatwave events into a single DataFrame
combined_heatwave_events = pd.concat(all_heatwave_events, keys=[event['station_number'].iloc[0] for event in all_heatwave_events], names=['station_number'])

# Combine all quantiles into a single DataFrame with station number as the first level index
combined_quantiles = pd.concat(all_quantiles, names=['day_of_year', 'station_number']).reorder_levels(['station_number', 'day_of_year'])

# Create the output directory if it doesn't exist
os.makedirs(output_directory, exist_ok=True)

# Save the combined heatwave events to a single CSV file
combined_heatwave_events.to_csv(output_file, float_format=float_precision)

# Save the combined quantiles to a single CSV file
combined_quantiles.to_csv(quantiles_file, float_format=float_precision)

print(f"All heatwave events saved to {output_file}.")
print(f"All quantiles saved to {quantiles_file}.")


