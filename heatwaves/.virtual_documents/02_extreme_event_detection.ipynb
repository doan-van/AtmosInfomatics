import matplotlib.pyplot as plt

def test_heatwave_detection(temp_series, heatwave_events, quantiles, quantile_value=0.9, specific_time=None):
    """
    Test the heatwave detection by plotting the original time series,
    detected events, and quantile threshold.

    Parameters:
        temp_series (pd.Series): Original temperature time series.
        heatwave_events (pd.DataFrame): Detected heatwave events.
        quantiles (pd.Series): Quantile thresholds for each day of year.
        quantile_value (float): Quantile value used for detection (default=0.9).
        specific_time (str): Specific time range for plotting (e.g., '1951-06-01 to 1951-09-01').
    """
    # Create a DataFrame for the temperature series
    temp_df = pd.DataFrame({'temp-max_C': temp_series})
    temp_df['day_of_year'] = temp_df.index.dayofyear

    # Map the quantile thresholds to the temperature DataFrame
    temp_df['temp_threshold'] = temp_df['day_of_year'].map(quantiles)

    # Filter data for the specific time range, if provided
    if specific_time:
        start_date, end_date = specific_time.split(' to ')
        temp_df = temp_df.loc[start_date:end_date]

    # Plot the original time series
    plt.figure(figsize=(12, 6))
    plt.plot(temp_df.index, temp_df['temp-max_C'], label='Temperature', color='blue')

    # Plot the quantile threshold
    plt.plot(temp_df.index, temp_df['temp_threshold'], 
             label=f'{int(quantile_value * 100)}th Percentile Threshold', 
             color='red', linestyle='--')

    # Highlight detected heatwave events
    label_added = False
    for _, event in heatwave_events.iterrows():
        if specific_time and (event['end_date'] < temp_df.index.min() or event['start_date'] > temp_df.index.max()):
            continue  # Skip events outside the specific range
        plt.axvspan(event['start_date'], event['end_date'], 
                    color='orange', alpha=0.3, 
                    label='Heatwave Event' if not label_added else None)
        label_added = True  # Set the flag to True after the first label is added

    # Customize the plot
    plt.title('Heatwave Detection Test')
    plt.xlabel('Date')
    plt.ylabel('Temperature (°C)')
    plt.legend()
    plt.grid(True)
    plt.tight_layout()

    # Show the plot
    plt.show()


