    data.index = pd.to_datetime(data.index)

# Add day of year for dynamic threshold calculation
data['day_of_year'] = data.index.dayofyear

# Compute the 90th percentile precipitation for each day of the year
quantiles = (
    data.groupby('day_of_year')['precip-accum_mm']
    .quantile(0.9)
    .rolling(window=15, center=True, min_periods=1)  # Smooth the threshold
    .mean()
)

# Map the smoothed threshold back to the original dataset
data = data.merge(quantiles.rename('precip_threshold'), on='day_of_year', how='left')

# Identify extreme precipitation days based on the dynamic threshold
data['is_extreme_precip'] = data['precip-accum_mm'] > data['precip_threshold']

# Group consecutive extreme precipitation days
data['precip_group'] = (data['is_extreme_precip'] != data['is_extreme_precip'].shift()).cumsum()

# Filter events with at least 1 day of extreme precipitation
extreme_precip_groups = []
for group, group_data in data[data['is_extreme_precip']].groupby('precip_group'):
    if len(group_data) > 0:  # Example: Minimum 1 day to consider an event
        extreme_precip_groups.append(group_data)

extreme_precip_events = pd.concat(extreme_precip_groups) if extreme_precip_groups else pd.DataFrame()

# Extract event details
