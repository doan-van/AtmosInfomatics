import pandas as pd
import numpy as np

def detect_heatwaves(temp_series, quantile=0.9, rolling_window=15, min_duration=3):
    """
    Detect heatwave events from a temperature series.
    
    Parameters:
        temp_series (pd.Series): Temperature series with a datetime index.
        quantile (float): Quantile for dynamic threshold calculation (default=0.9).
        rolling_window (int): Rolling window size for smoothing (default=15).
        min_duration (int): Minimum consecutive days for a heatwave event (default=3).
        
    Returns:
        pd.DataFrame: Heatwave events with start date, end date, duration,
                      mean temperature, climatological mean, and temperature anomaly.
    """
    # Create a DataFrame with temperature and day of year
    temp_df = pd.DataFrame({'temp-max_C': temp_series})
    temp_df['day_of_year'] = temp_df.index.dayofyear

    # Compute the 90th percentile temperature for each day of the year
    quantiles = (
        temp_df['temp-max_C']
        .groupby(temp_df['day_of_year'])
        .quantile(quantile)
        .rolling(window=rolling_window, center=True, min_periods=1)
        .mean()
        .rolling(window=rolling_window, center=True, min_periods=1)
        .mean()
    )

    # Map the smoothed threshold back to the temperature DataFrame
    temp_df['temp_threshold'] = temp_df['day_of_year'].map(quantiles)

    # Identify heatwave days using the dynamic threshold
    temp_df['is_heatwave_day'] = temp_df['temp-max_C'] > temp_df['temp_threshold']

    # Identify consecutive heatwave days
    temp_df['heatwave_group'] = (temp_df['is_heatwave_day'] != temp_df['is_heatwave_day'].shift()).cumsum()

    # Filter heatwaves with at least `min_duration` consecutive days
    heatwave_groups = temp_df[temp_df['is_heatwave_day']].groupby('heatwave_group')
    filtered_groups = []
    for group, group_data in heatwave_groups:
        if len(group_data) >= min_duration:
            filtered_groups.append(group_data)

    heatwave_filtered = pd.concat(filtered_groups) if filtered_groups else pd.DataFrame()

    # Extract heatwave event information
    heatwave_events = []
    if not heatwave_filtered.empty:
        for group, group_data in heatwave_filtered.groupby('heatwave_group'):
            start_date = group_data.index.min()  # First date of the group
            end_date = group_data.index.max()    # Last date of the group
            duration = len(group_data)          # Number of days in the group
            mean_temp = group_data['temp-max_C'].mean()  # Mean temperature of the group
            climate_mean_temp = group_data['day_of_year'].map(quantiles).mean()  # Climatological mean temperature
            temp_anomaly = mean_temp - climate_mean_temp  # Difference from climatology

            heatwave_events.append({
                'start_date': start_date,
                'end_date': end_date,
                'duration': duration,
                'mean_temp': mean_temp,
                'climate_mean_temp': climate_mean_temp,
                'temp_anomaly': temp_anomaly
            })

    # Convert to DataFrame
    heatwave_events_df = pd.DataFrame(heatwave_events)
    heatwave_events_df.set_index('start_date', inplace=True)
    return heatwave_events_df, quantiles

